# DaycareOS Environment Configuration Example
# Copy this file to .env and provide your project credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=daycare-os-2026
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_STORAGE_BUCKET=daycare-os-2026.firebasestorage.app
